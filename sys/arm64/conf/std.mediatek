#
# MediaTek SoC support
#

# SoC support
options 	SOC_MEDIATEK
options 	SOC_MEDIATEK_MT7986

# Serial (COM) ports
device		uart_ns8250		# ns8250-type UART driver

options 	FDT

# Ethernet
device		mtketh
device		mt7531sw		# MT7531 switch on the MDIO bus

# DTBs
makeoptions	MODULES_EXTRA+="dtb/mediatek"
